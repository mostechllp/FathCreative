# ================================================================
# 404 Error Document
# ================================================================
# [FOR LIVE PRODUCTION fathcreative.com (Root)]:
ErrorDocument 404 /404.php

# [FOR STAGING / SUBFOLDER /FathCreative/]:
# ErrorDocument 404 /FathCreative/404.php

# ─── Engine & Options ───────────────────────────────────────────
RewriteEngine On

# [FOR LIVE PRODUCTION fathcreative.com (Root)]:
RewriteBase /

# [FOR STAGING / SUBFOLDER /FathCreative/]:
# RewriteBase /FathCreative/

Options -MultiViews
Options +FollowSymlinks
AcceptPathInfo Off

# ─── GZIP Compression ───────────────────────────────────────────
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html
    AddOutputFilterByType DEFLATE text/css
    AddOutputFilterByType DEFLATE text/javascript
    AddOutputFilterByType DEFLATE application/javascript
    AddOutputFilterByType DEFLATE application/x-javascript
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/woff2
    AddOutputFilterByType DEFLATE font/woff
    AddOutputFilterByType DEFLATE application/font-woff2
</IfModule>

# ─── Cache Lifetimes ────────────────────────────────────────────
<IfModule mod_expires.c>
    ExpiresActive On

    # Images - 1 year
    ExpiresByType image/webp             "access plus 1 year"
    ExpiresByType image/jpeg             "access plus 1 year"
    ExpiresByType image/png              "access plus 1 year"
    ExpiresByType image/gif              "access plus 1 year"
    ExpiresByType image/svg+xml          "access plus 1 year"
    ExpiresByType image/x-icon           "access plus 1 year"

    # Fonts - 1 year
    ExpiresByType font/woff2             "access plus 1 year"
    ExpiresByType font/woff              "access plus 1 year"
    ExpiresByType font/ttf               "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"
    ExpiresByType application/font-woff  "access plus 1 year"

    # CSS & JS - 1 year
    ExpiresByType text/css               "access plus 1 year"
    ExpiresByType application/javascript "access plus 1 year"
    ExpiresByType text/javascript        "access plus 1 year"

    # HTML - 1 hour
    ExpiresByType text/html              "access plus 1 hour"
</IfModule>

# ─── Cache-Control Headers ──────────────────────────────────────
<IfModule mod_headers.c>
    # Static assets - 1 year
    <FilesMatch "\.(webp|jpg|jpeg|png|gif|svg|ico|woff2|woff|ttf|css|js)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>

    # HTML - 1 hour
    <FilesMatch "\.html$">
        Header set Cache-Control "public, max-age=3600"
    </FilesMatch>

    # Security Headers
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ─── Force HTTPS ────────────────────────────────────────────────
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

# ─── Force WWW (production only) ────────────────────────────────
RewriteCond %{HTTP_HOST} ^fathcreative\.com$ [NC]
RewriteRule ^(.*)$ https://www.fathcreative.com/$1 [R=301,L]

# ─── Redirect events-details to event-management ────────────────
# [FOR LIVE PRODUCTION (Root)]:
RewriteRule ^events-details(\.php)?$ /event-management [R=301,L]
# [FOR STAGING / SUBFOLDER]:
# RewriteRule ^events-details(\.php)?$ event-management [R=301,L]

# ─── Dynamic 301 Redirects are now handled automatically by project-details.php ──

# ─── Redirect index.php to root ─────────────────────────────────
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ (.*?/)?index\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# ─── Remove .php extension from URLs ────────────────────────────
RewriteCond %{ENV:REDIRECT_STATUS} ^$
RewriteCond %{REQUEST_METHOD} !POST
RewriteCond %{THE_REQUEST} ^[A-Z]{3,9}\ (.*?)\.php[\s?] [NC]
RewriteRule ^ %1 [R=301,L]

# ─── Redirect old /project/{id}/{slug} → /projects/{slug} ───────
# [FOR LIVE PRODUCTION (Root)]:
RewriteRule ^project/[0-9]+/([^/]+)/?$ /projects/$1 [R=301,L]
# [FOR STAGING / SUBFOLDER]:
# RewriteRule ^project/[0-9]+/([^/]+)/?$ projects/$1 [R=301,L]

# New Dynamic URL Structure: /projects/{slug}
RewriteRule ^projects/([^/]+)/?$ project-details.php?slug=$1 [L,QSA]

# Blog Route Rewrites
RewriteRule ^blogs/?$ blogs.php [L,QSA]
RewriteRule ^blogs/event-fabrication-saudi-arabia/?$ event-fabrication-saudi-arabia.php [L,QSA]
RewriteRule ^blogs/cityscape-global-2026/?$ cityscape-global-2026.php [L,QSA]
RewriteRule ^blogs/cityscape-global-2026-saudi-arabia/?$ cityscape-global-2026-saudi-arabia.php [L,QSA]
RewriteRule ^blogs/leap-2026-booth-design-guide-riyadh/?$ leap-2026-booth-design-guide-riyadh.php [L,QSA]
RewriteRule ^blogs/trade-show-booth-design-ideas/?$ trade-show-booth-design-ideas.php [L,QSA]
RewriteRule ^blogs/corrugated-displays-saudi-arabia/?$ corrugated-displays-saudi-arabia.php [L,QSA]
RewriteRule ^blogs/exhibition-stand-builder-saudi/?$ exhibition-stand-builder-saudi.php [L,QSA]
RewriteRule ^blogs/([^/]+)/?$ blogs/$1.php [L,QSA]

# ─── Extensionless PHP Files ────────────────────────────────────
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*)$ $1.php [L]

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^([^/]+)/$ $1.php [L]