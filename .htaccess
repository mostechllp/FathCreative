RewriteEngine On
RewriteBase /FathCreative/
ErrorDocument 404 /FathCreative/404.php

# Redirect .php to clean URL (fixed)
RewriteCond %{THE_REQUEST} \s/+FathCreative/(.+?)\.php[\s?] [NC]
RewriteRule ^ /FathCreative/%1 [R=301,L]

# Internally load .php
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^([^/]+)/?$ $1.php [L]